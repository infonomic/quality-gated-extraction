{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forru:extraction-benchmark:paper-value:v1",
  "title": "Traceable paper value",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "key", "name", "label", "value", "sourceRunId", "sourceMetric"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "key": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "label": { "enum": ["observed", "sampled", "projected", "unavailable"] },
    "value": { "type": ["number", "integer", "string", "null"] },
    "unit": { "type": "string", "minLength": 1 },
    "sourceRunId": { "type": "string", "minLength": 1 },
    "sourceMetric": { "type": "string", "minLength": 1 },
    "numerator": { "type": "number" },
    "denominator": { "type": "number", "minimum": 0 },
    "excludedCount": { "type": "integer", "minimum": 0 },
    "caseIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^F[0-9]{3,}$" }
    },
    "note": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "label": { "const": "unavailable" } } },
      "then": { "properties": { "value": { "type": "null" } } },
      "else": { "properties": { "value": { "not": { "type": "null" } } } }
    }
  ]
}
