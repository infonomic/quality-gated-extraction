{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forru:extraction-benchmark:decision:v1",
  "title": "Routing and quality-gate decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "policyVersion",
    "inspectionHash",
    "initialTier",
    "rationale",
    "confidence",
    "steps",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "pattern": "^F[0-9]{3,}$" },
    "policyVersion": { "type": "string", "minLength": 1 },
    "inspectionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "initialTier": { "enum": ["T0", "T1", "T2"] },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reasonCode" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tier", "artifactKey", "passed", "components", "reasons"],
        "properties": {
          "tier": { "enum": ["T0", "T1", "T2", "T3"] },
          "artifactKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "passed": { "type": "boolean" },
          "components": {
            "type": "object",
            "additionalProperties": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 1
            }
          },
          "reasons": { "type": "array", "items": { "$ref": "#/$defs/reasonCode" } },
          "nextTier": { "enum": ["T1", "T2", "T3"] }
        }
      }
    },
    "status": { "enum": ["accepted", "low-confidence", "unavailable"] },
    "finalTier": { "enum": ["T0", "T1", "T2", "T3"] },
    "selectedArtifactKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "reasonCode": {
      "enum": [
        "TEXT_LAYER_INTACT",
        "LOW_TEXT_LAYER_COVERAGE",
        "HIGH_FULL_PAGE_IMAGE_RATIO",
        "ENCODING_ANOMALY",
        "STRUCTURE_COMPLEXITY",
        "MISSING_REQUIRED_SIGNAL",
        "MIXED_SCRIPT",
        "CHARACTER_SANITY_FAILED",
        "TEXT_RETENTION_FAILED",
        "USABLE_PAGE_RATIO_FAILED",
        "STRUCTURAL_YIELD_FAILED",
        "SCRIPT_CONSISTENCY_FAILED",
        "PROVIDER_FAILED",
        "PROVIDER_UNAVAILABLE",
        "MAX_ESCALATIONS_REACHED",
        "TERMINAL_TIER_FAILED"
      ]
    }
  }
}
